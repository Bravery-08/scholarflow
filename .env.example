# ── External LLM APIs ─────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-..."
GROQ_API_KEY="gsk_..."
GOOGLE_API_KEY="AIza..."
HF_TOKEN="hf_..."

# ── Model strings ─────────────────────────────────────────────────
VISUAL_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
SYNTHESIS_MODEL="llama-3.3-70b-versatile"
CRITIC_MODEL="gemini-2.5-flash"
ORCHESTRATOR_MODEL="qwen3.5:4b"
FINETUNED_MODEL_ID="your-hf-username/scholarflow-qwen3-8b"

# ── Ollama ────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://ollama:11434"

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER="scholar"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="scholarflow"
POSTGRES_URL="postgresql://scholar:changeme@postgres:5432/scholarflow"

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"

# ── Chroma ────────────────────────────────────────────────────────
CHROMA_HOST="chroma"
CHROMA_PORT="8000"

# ── JWT ───────────────────────────────────────────────────────────
SECRET_KEY="replace-with-output-of-secrets-token-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# ── App ───────────────────────────────────────────────────────────
APP_PORT="8080"
DEBUG="true"